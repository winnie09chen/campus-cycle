# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 切勿把真实密钥写进 .env.example

# 阿里云百炼 DashScope（VLM/NLP） https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 邮件服务（QQ 或 163 邮箱 SMTP，用于注册验证码 & 随机密码发送）
# QQ 邮箱：登录 QQ 邮箱 → 设置 → 账户 → 开启 IMAP/SMTP → 获取授权码（即 MAIL_PASS）
# 163 邮箱：登录 163 邮箱 → 设置 → POP3/SMTP/IMAP → 开启 SMTP → 获取授权码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=物候 <>
